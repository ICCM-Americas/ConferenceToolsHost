{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "bacon/bacon-qr-code": "^3.1",
        "conference-tools/bof-scheduler": "*",
        "conference-tools/branding": "*",
        "conference-tools/registration": "*",
        "laravel/framework": "^13.8",
        "laravel/passkeys": "^0.2.1",
        "laravel/tinker": "^3.0",
        "pragmarx/google2fa": "^9.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/conference-tools/bof-scheduler"
        },
        {
            "type": "path",
            "url": "packages/conference-tools/branding"
        },
        {
            "type": "path",
            "url": "packages/conference-tools/registration"
        }
    ],
    "require-dev": {
        "brianium/paratest": "^7.0",
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" --names=server,queue,logs --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test --parallel"
        ],
        "test:coverage": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test --parallel --coverage-html coverage/html --coverage-clover coverage/clover.xml"
        ],
        "test:github": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "test:coverage:github": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test --coverage-html coverage/html --coverage-clover coverage/clover.xml"
        ],
        "test:package": [
            "@composer --working-dir=packages/conference-tools/branding test",
            "@composer --working-dir=packages/conference-tools/bof-scheduler test",
            "@composer --working-dir=packages/conference-tools/registration test"
        ],
        "test:package:coverage": [
            "@composer --working-dir=packages/conference-tools/branding test:coverage",
            "@composer --working-dir=packages/conference-tools/bof-scheduler test:coverage",
            "@composer --working-dir=packages/conference-tools/registration test:coverage"
        ],
        "test:ui": [
            "npm run test:ui"
        ],
        "test:all": [
            "@composer test",
            "@composer test:package",
            "@composer test:ui"
        ],
        "test:all:coverage": [
            "@composer test:coverage",
            "@composer test:package:coverage",
            "@composer test:ui"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "conference-tools/bof-scheduler",
                "conference-tools/branding",
                "conference-tools/registration"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "process-timeout": 0
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
